{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
  },
  "AllowedHosts": "*",
  "Database": { "AutoInit": false },
  "Workers": { "Enabled": true, "Reconciliation": true },
  "RabbitMq": { "Enabled": true, "Host": "localhost", "Port": 5672, "User": "guest", "Password": "guest", "Exchange": "escrow.events" },
  "Payments": { "Provider": "Mock" },
  "Escrow": {
    "PlatformFeeBps": 200,
    "PaymentWindowMinutes": 15,
    "OtpLifetimeHours": 24,
