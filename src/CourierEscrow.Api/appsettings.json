    "DefaultCurrency": "MWK"
  },
  "Sms": { "Provider": "Log" },
  "Storage": { "RootPath": "data/objects", "PublicBaseUrl": "http://localhost:5080", "UploadLinkMinutes": 10 },
  "Cors": { "Origins": [ "http://localhost:5090" ] },
  "OneKhusa": {
    "Environment": "Sandbox",
    "MerchantAccountNumber": 0,
    "AirtelConnectorId": 0,
    "TnmConnectorId": 0
  }
