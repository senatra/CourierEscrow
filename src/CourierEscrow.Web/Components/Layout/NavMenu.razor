<aside class="sidebar @(Open ? "open" : null)">
    <a class="brand" href="/" @onclick="Navigate">
        <span class="logo" aria-hidden="true">◈</span>
        <div>
            <strong>Nexa Escrow</strong>
            <small>Ops console</small>
        </div>
    </a>

    <nav>
        <p class="nav-label">Work</p>
        <NavLink href="/" Match="NavLinkMatch.All" @onclick="Navigate">Dashboard</NavLink>
        <NavLink href="/orders" Match="NavLinkMatch.Prefix" @onclick="Navigate">Orders</NavLink>

        <p class="nav-label">Money</p>
        <NavLink href="/payouts" @onclick="Navigate">Payouts</NavLink>
        <NavLink href="/disputes" @onclick="Navigate">Disputes</NavLink>
        <NavLink href="/reconciliation" @onclick="Navigate">Reconciliation</NavLink>

        <p class="nav-label">People</p>
        <NavLink href="/couriers" @onclick="Navigate">Couriers</NavLink>
        <AuthorizeView Roles="ops_admin">
            <NavLink href="/users" @onclick="Navigate">Users</NavLink>
        </AuthorizeView>
    </nav>

    <p class="sidebar-note">Buyer pays, money is held, the courier hands over, the buyer's code releases it. Every kwacha is a ledger entry.</p>
</aside>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }

    private Task Navigate() => OnNavigate.InvokeAsync();
}
