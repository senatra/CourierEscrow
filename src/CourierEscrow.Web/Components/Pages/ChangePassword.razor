@page "/account/password"
@layout AuthLayout
@inject EscrowApiClient Api
@inject NavigationManager Nav

<PageTitle>Change password · Nexa Escrow</PageTitle>

<h1>Change password</h1>
@if (forced) { <Notice Message="You are using a temporary password. Choose your own to continue." Kind="info" /> }
<Notice Message="@error" Kind="error" />

<EditForm Model="Input" FormName="change-password" OnValidSubmit="Save" method="post" class="form">
    <label>Current password
        <InputText class="input" type="password" @bind-Value="Input.Current" autocomplete="current-password" />
    </label>
    <label>New password
        <InputText class="input" type="password" @bind-Value="Input.New" autocomplete="new-password" />
    </label>
    <label>Repeat new password
        <InputText class="input" type="password" @bind-Value="Input.Repeat" autocomplete="new-password" />
    </label>
    <p class="muted small">At least 5 characters. Changing it signs you out everywhere else.</p>
    <button type="submit" class="btn primary block">Change password</button>
</EditForm>

@if (!forced) { <p class="small"><a href="/">Back to the dashboard</a></p> }
else
{
    <form method="post" action="/account/logout"><button type="submit" class="btn ghost block">Sign out</button></form>
}

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromForm] private PasswordInput Input { get; set; } = new();

    private string? error;
    private bool forced;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null) forced = (await AuthState).User.HasClaim(ConsoleSession.PasswordChangeClaim, "true");
    }

    private async Task Save()
    {
        if (HttpContext is null) return;
        if (Input.New != Input.Repeat) { error = "The new passwords do not match."; return; }
        try
        {
            // The API revokes every older session and hands back a fresh one, which replaces this cookie.
            var login = await Api.ChangePassword(Input.Current, Input.New);
            await ConsoleSession.SignInAsync(HttpContext, login);
            Nav.NavigateTo("/");
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
    }

    private sealed class PasswordInput
    {
        public string Current { get; set; } = "";
        public string New { get; set; } = "";
        public string Repeat { get; set; } = "";
    }
}
